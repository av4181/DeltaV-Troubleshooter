{
  "meta": {
    "id": "operate-data",
    "title": "DeltaV Operate: datalink or animation not showing or writing the correct value (NK-1000-0176 §8.5)",
    "priorsReviewed": false
  },
  "hypotheses": [
    {
      "id": "dvsys_down",
      "title": "DVSYS.exe is not running or failed to register (DCOM)",
      "description": "DVSYS is the data server Operate polls. If it is not running, every datalink fails. The guide points at DCOM errors on DVSYS and at re-registering with regall.",
      "domain": "Operate",
      "layer": "transport-session",
      "mechanism": "dcom-rpc",
      "prior": "possible",
      "actions": [
        "Check Task Manager for DVSYS.exe",
        "Look for DCOM errors on DVSYS in the Windows Event Log",
        "Run regall /register (Controlled Impact)",
        "Check for communication hotfixes"
      ],
      "sources": [
        "NK-1000-0176 §8.5.2.1"
      ]
    },
    {
      "id": "base_services",
      "title": "A base DeltaV service is stopped (RTRocService, DVCommService, DeltaV Service)",
      "description": "DVSYS can run while the services that bring it its data are down.",
      "domain": "Operate",
      "layer": "transport-session",
      "prior": "unlikely",
      "actions": [
        "Check the three services",
        "Look for communication-related hotfixes",
        "Restart services only per the site procedure"
      ],
      "sources": [
        "NK-1000-0176 §8.5.2.1"
      ]
    },
    {
      "id": "comm_lost",
      "title": "This workstation lost its connection to the DeltaV network",
      "description": "Shows as a red X for the node in DeltaV Diagnostics and as 'Network Transaction is in Progress' or not-communicating datalinks. On v7.3-v9.x, operator stations with simplex communication could make DVCommService on other stations exit (AP-0700-0094).",
      "domain": "Operate",
      "layer": "network",
      "prior": "possible",
      "actions": [
        "Open DeltaV Diagnostics from this workstation",
        "Check both network connections and the switch ports",
        "Check DVCommService"
      ],
      "sources": [
        "NK-1000-0176 §8.3.1, §8.5.4",
        "AP-0700-0094"
      ]
    },
    {
      "id": "controller_comm",
      "title": "The controller of the affected modules is not communicating",
      "description": "Only the datalinks and animations of one controller or module fail (@@@@ or ****).",
      "domain": "Controller",
      "layer": "network",
      "prior": "possible",
      "actions": [
        "Check the controller in Diagnostics from the affected workstation",
        "Test the parameter with Watchit and repeat from another workstation"
      ],
      "sources": [
        "NK-1000-0176 §8.5.2.2"
      ]
    },
    {
      "id": "stale_scr",
      "title": "DT.scr / MODT.scr are outdated on this workstation",
      "description": "The workstation lacks current module/data tables. The guide recreates them by downloading the workstation.",
      "domain": "Operate",
      "layer": "application",
      "prior": "possible",
      "actions": [
        "Check the timestamps of DT.scr and MODT.scr",
        "Download the workstation to recreate them (Controlled Impact)"
      ],
      "sources": [
        "NK-1000-0176 §8.5.2.2"
      ]
    },
    {
      "id": "invalid_datasource",
      "title": "Pictures contain invalid datasources",
      "description": "Invalid datasources cause intermittent &&&& and magenta, high CPU and temporary lockups. Closing Operate may take about 10 minutes for DVSYS to exit.",
      "domain": "Operate",
      "layer": "application",
      "prior": "likely",
      "actions": [
        "Open DVStatus.grf in Run mode and check the ADD header for errors",
        "Walk through all pictures and user scenarios that change datasource references",
        "Run DumpDataSources (AP-0800-0053)"
      ],
      "sources": [
        "NK-1000-0176 §8.2.4, §8.5.2.3, §8.5.4",
        "AP-0500-0075",
        "AP-0800-0053"
      ]
    },
    {
      "id": "tag_group_expr",
      "title": "Tag group symbol in a datasource expression",
      "description": "Datasources that are expressions containing a tag group symbol show **** or magenta, especially when operators are not separated by spaces. Listed for v8.x-v12.x; the guide does not say later versions are unaffected.",
      "domain": "Operate",
      "layer": "application",
      "prior": "unlikely",
      "actions": [
        "Read the complete datasource path",
        "Check that operators (+, -, /, *, OR, AND) are separated by spaces",
        "Follow AP-0900-0144"
      ],
      "sources": [
        "NK-1000-0176 §8.5.4",
        "AP-0900-0144"
      ]
    },
    {
      "id": "notify_stale",
      "title": "Updates for this module do not reach this workstation",
      "description": "The value is right at the source and on other workstations but not here. The guide gives OCNDiag, UnsolDiag, Watchit and OPCWatchit to follow the data, but names no single root cause, so this is a working hypothesis for 'value differs per workstation'.",
      "domain": "Operate",
      "layer": "transport-session",
      "mechanism": "roc-udp",
      "prior": "possible",
      "verified": false,
      "actions": [
        "Follow the data with UnsolDiag, Watchit and OPCWatchit",
        "On v10.3.x and earlier also use OCNDiag",
        "Escalate with the tool output"
      ],
      "sources": [
        "NK-1000-0176 §8.5.2.4"
      ]
    },
    {
      "id": "scu_paths",
      "title": "Operator System Configuration Utility paths are wrong",
      "description": "A faceplate for one module writes to another module when the SCU paths do not point to the local node name and directory. Listed for v8.x-v14.x.",
      "domain": "Operate",
      "layer": "application",
      "prior": "unlikely",
      "actions": [
        "Open the Operator System Configuration Utility",
        "Point the paths to the local node name and directory"
      ],
      "sources": [
        "NK-1000-0176 §5.a, §8.5.4",
        "AP-0900-0176"
      ]
    },
    {
      "id": "thisnode_remote",
      "title": "Fix32.ThisNode datasources in a Remote Client session",
      "description": "Datalinks, animations or VB reads that use Fix32.ThisNode return nothing in Remote Terminal Server sessions while the same objects work locally. Listed for v8.x-v14.FP1.",
      "domain": "Operate",
      "layer": "application",
      "prior": "unlikely",
      "actions": [
        "Open the picture in Configure mode and check the full path",
        "Check whether it uses Fix32.ThisNode or DVSYS as dataserver"
      ],
      "sources": [
        "NK-1000-0176 §8.5.4",
        "NK-1000-0105"
      ]
    }
  ],
